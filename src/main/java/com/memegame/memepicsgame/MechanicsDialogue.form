              <SubComponents>
                <Component class="javax.swing.JTextArea" name="txtHowToPlay">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="Segoe UI" size="14" style="0"/>
                    </Property>
                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="   HOW TO PLAY&#xa;   &#x2022; Look at the 4 pictures and guess the one word that connects them.&#xa;   &#x2022; Tap letters to fill the boxes. Tap a filled box to take the letter back.&#xa;   &#x2022; Stuck? Use the Clue button to reveal a letter. It costs 1 clue credit.&#xa;   &#x2022; You start with 3 credits and earn 1 for every meme you solve.&#xa;&#xa;   THEMES&#xa;   &#x2022; Solve enough memes in a theme to unlock the next one.&#xa;   &#x2022; Your progress saves automatically. Continue picks up where you left off."/>
                    <Property name="wrapStyleWord" type="boolean" value="true"/>
                  </Properties>
                </Component>
              </SubComponents>
